<Project>
  <PropertyGroup Label="Central Versions">
    <!-- The registry pins live in registry/manifest.yaml and reach the build through the
         generated generated/pins.props. WeaverVersion is the one pin MSBuild owns:
         scripts/generate.sh refuses a Weaver binary of any other version, and
         scripts/check-pin-freshness.py and Renovate read it. The binary itself comes from
         mise.toml, which `mise install` installs, so a Weaver bump moves both. -->
    <WeaverVersion>0.28.0</WeaverVersion>

    <!-- renovate: datasource=nuget depName=ANcpLua.Roslyn.Utilities -->
    <ANcpLuaRoslynUtilitiesVersion>3.0.0</ANcpLuaRoslynUtilitiesVersion>
    <!-- renovate: datasource=nuget depName=Microsoft.CodeAnalysis.CSharp -->
    <MicrosoftCodeAnalysisVersion>5.9.0</MicrosoftCodeAnalysisVersion>

    <!-- Stay on 10.x. Fallout's 11.0.x packages on nuget.org are unlisted builds from May 2026, older than 10.4.0. -->
    <!-- renovate: datasource=nuget depName=Fallout.Common -->
    <FalloutVersion>10.4.0</FalloutVersion>

    <!-- renovate: datasource=nuget depName=DotCov.Fallout -->
    <DotCovVersion>4.7.0</DotCovVersion>

    <!-- The patched build for GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7, GHSA-7hqp-7c5m-4vq6,
         GHSA-c399-9853-6jmj and GHSA-r955-8q5j-3h83 (2026-10-13); Directory.Packages.props pins
         both packages transitively. -->
    <!-- renovate: datasource=nuget depName=System.Security.Cryptography.Pkcs -->
    <SystemSecurityCryptographyVersion>10.0.13</SystemSecurityCryptographyVersion>
    <!-- renovate: datasource=nuget depName=NuGet.Packaging -->
    <NuGetPackagingVersion>7.9.0</NuGetPackagingVersion>
    <!-- renovate: datasource=nuget depName=System.Diagnostics.DiagnosticSource -->
    <SystemDiagnosticsDiagnosticSourceVersion>10.0.12</SystemDiagnosticsDiagnosticSourceVersion>
  </PropertyGroup>
</Project>
