{% if (note | length) > 0 %}
{{ lib.doc_block(pad, "remarks", note) }}
{% endif %}
{% if m.deprecated %}
{{ lib.obsolete_line(pad, m.deprecated) }}
{% endif %}
{{ pad }}public static readonly global::Qyl.Telemetry.SemanticConventions.MetricDefinition<global::Qyl.Telemetry.SemanticConventions.{{ instrument }}> {{ field }} =
{{ pad }}    new(
{{ pad }}        name: "{{ lib.escape_attribute(m.name) }}",
{{ pad }}        unit: "{{ lib.escape_attribute(m.unit | default("", true)) }}",
