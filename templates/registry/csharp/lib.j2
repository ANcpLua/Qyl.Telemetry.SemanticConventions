{#-
  Shared macros for the C# templates.

  The markdown-to-XML-doc conversion is the contract of the shipped constant files: registry
  brief/note fields are GitHub-flavoured markdown, C# XML doc comments are parsed as XML, and a
  mismatched tag makes the compiler drop the whole comment. Every construct therefore emits
  balanced or self-closing XML only:

    paragraph break  -> a self-closing <para/> separator line
    inline code      -> <c>
    fenced code      -> a <code> block
    link             -> <a href> with balanced-parenthesis URL parsing; image -> alt text only
    GitHub alert     -> [!WARNING] becomes "Warning:"
    blockquote       -> markers stripped; a leading quote block is wrapped in <blockquote>
    GFM separator    -> dropped

  All literal text is XML-escaped. Ordinal ordering is done in the JQ filters, not here:
  MiniJinja's `sort` is case-insensitive.
-#}

{#- A generation parameter scripts/generate.sh must supply. An unset one writes an explicit
    error marker into the generated file instead of a stale value, so a bare
    `weaver registry generate` cannot produce output that looks current: the marker is not
    valid C#, and scripts/check-generated.sh fails on the diff. -#}
{%- macro param(name, value) -%}
{%- if value -%}{{ value }}{%- else -%}{{ "error: missing param " ~ name }}{%- endif -%}
{%- endmacro -%}

{#- The provenance line every generated file carries. The schema URLs are registry facts and
    arrive on `ctx`; the Weaver version and the two upstream refs arrive as parameters. -#}
{%- macro provenance(weaver_version, qyl_schema_url, core_ref, genai_commit) -%}
Generated by Weaver {{ param("weaver_version", weaver_version) }} from qyl registry {{ param("qyl_schema_url", qyl_schema_url) }} (core {{ param("core_ref", core_ref) }}, genai {{ param("genai_commit", genai_commit) }})
{%- endmacro -%}

{#- XML-escape. -#}
{%- macro esc(t) -%}
{{ t | replace("&", "&amp;") | replace("<", "&lt;") | replace(">", "&gt;") }}
{%- endmacro -%}

{#- PascalCase: split on `.`, `_`, `-`, `*` and space, upper-case the first character of each
    segment, keep the rest verbatim. Deliberately not Weaver's `pascal_case`, which also
    splits camelCase and lower-cases the remainder. `*` is a separator because a vendor
    ActivitySource name may be an `AddSource` prefix pattern (`Azure.*`), and the constant
    that carries it still has to be a C# identifier. -#}
{%- macro pascal(v) -%}
{%- set s = namespace(out = "") -%}
{%- for seg in v | replace("_", ".") | replace("-", ".") | replace("*", ".") | replace(" ", ".") | split(".") -%}
{%- if (seg | length) > 0 -%}
{%- set s.out = s.out ~ (seg[0] | upper) ~ seg[1:] -%}
{%- endif -%}
{%- endfor -%}
{{ s.out }}
{%- endmacro -%}

{#- Whitespace runs collapsed to one space, then trimmed. -#}
{%- macro collapse(t) -%}
{{ t | split | join(" ") }}
{%- endmacro -%}

{#- First character upper-cased, the rest lower-cased. -#}
{%- macro capitalize_word(w) -%}
{%- if (w | length) > 0 -%}{{ (w[0] | upper) ~ (w[1:] | lower) }}{%- endif -%}
{%- endmacro -%}

{#- Index of `needle` in `hay` at or after `start`, or -1. -#}
{%- macro index_of(hay, needle, start) -%}
{%- set m = needle | length -%}
{%- set s = namespace(r = -1) -%}
{%- for k in range(start, (hay | length) - m + 1) -%}
{%- if s.r < 0 and hay[k:k + m] == needle -%}{%- set s.r = k -%}{%- endif -%}
{%- endfor -%}
{{ s.r }}
{%- endmacro -%}

{#- A GitHub alert `[!WORD]` anchored at `start`: "<end>\t<word>", or "" when absent. -#}
{%- macro parse_alert(text, start) -%}
{%- set n = text | length -%}
{%- if start + 2 < n and text[start:start + 2] == "[!" -%}
{%- set a = namespace(j = start + 2, closed = false, stop = false, word = "") -%}
{%- for k in range(start + 2, n) -%}
{%- if not a.stop -%}
{%- set c = text[k] -%}
{%- if c == "]" -%}
{%- set a.j = k + 1 -%}{%- set a.closed = true -%}{%- set a.stop = true -%}
{%- elif (c | lower) != (c | upper) or c in "0123456789_" -%}
{%- set a.word = a.word ~ c -%}
{%- else -%}
{%- set a.stop = true -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if a.closed and (a.word | length) > 0 -%}{{ a.j ~ "\t" ~ a.word }}{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{#- A markdown link or image body whose `[` sits at `start`. Bracketed text may nest and span
    newlines; the URL is read with balanced parentheses so inner or trailing `)` stay in the
    href instead of truncating the link. Returns "ok\t<end>\t<text>\t<url>" or "no". -#}
{%- macro parse_link(text, start) -%}
{%- set n = text | length -%}
{%- if start >= n or text[start] != "[" -%}
no
{%- else -%}
{%- set t = namespace(i = start + 1, depth = 1, body = "", closed = false, stop = false) -%}
{%- for k in range(start + 1, n) -%}
{%- if not t.stop -%}
{%- set c = text[k] -%}
{%- if c == "[" -%}
{%- set t.depth = t.depth + 1 -%}{%- set t.body = t.body ~ c -%}
{%- elif c == "]" -%}
{%- set t.depth = t.depth - 1 -%}
{%- if t.depth == 0 -%}
{%- set t.i = k + 1 -%}{%- set t.closed = true -%}{%- set t.stop = true -%}
{%- else -%}
{%- set t.body = t.body ~ c -%}
{%- endif -%}
{%- else -%}
{%- set t.body = t.body ~ c -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if (not t.closed) or t.i >= n or text[t.i] != "(" -%}
no
{%- else -%}
{%- set u = namespace(i = t.i + 1, depth = 1, url = "", closed = false, stop = false) -%}
{%- for k in range(t.i + 1, n) -%}
{%- if not u.stop -%}
{%- set c = text[k] -%}
{%- if c == "(" -%}
{%- set u.depth = u.depth + 1 -%}{%- set u.url = u.url ~ c -%}
{%- elif c == ")" -%}
{%- set u.depth = u.depth - 1 -%}
{%- if u.depth == 0 -%}
{%- set u.i = k + 1 -%}{%- set u.closed = true -%}{%- set u.stop = true -%}
{%- else -%}
{%- set u.url = u.url ~ c -%}
{%- endif -%}
{%- else -%}
{%- set u.url = u.url ~ c -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if not u.closed -%}
no
{%- else -%}
{{ "ok\t" ~ u.i ~ "\t" ~ t.body ~ "\t" ~ u.url }}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{#- Inline markdown (which may span newlines) to escaped XML-doc markup. -#}
{%- macro render_inline(text) -%}
{%- set n = text | length -%}
{%- set s = namespace(i = 0, out = "", done = false) -%}
{%- for _token in range(n) -%}
{%- if s.i < n -%}
{%- set ch = text[s.i] -%}
{%- set s.done = false -%}
{%- if ch == "`" -%}
{%- set b = namespace(j = s.i + 1, stop = false) -%}
{%- for k in range(s.i + 1, n) -%}
{%- if not b.stop -%}
{%- if text[k] == "`" -%}{%- set b.j = k + 1 -%}{%- else -%}{%- set b.stop = true -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- set ticks = text[s.i:b.j] -%}
{%- set close = index_of(text, ticks, b.j) | int -%}
{%- if close < 0 -%}
{%- set s.out = s.out ~ esc(ch) -%}
{%- set s.i = s.i + 1 -%}
{%- else -%}
{%- set s.out = s.out ~ "<c>" ~ esc(text[b.j:close]) ~ "</c>" -%}
{%- set s.i = close + (ticks | length) -%}
{%- endif -%}
{%- set s.done = true -%}
{%- endif -%}
{%- if (not s.done) and ch == "!" and s.i + 1 < n and text[s.i + 1] == "[" -%}
{%- set link = parse_link(text, s.i + 1) -%}
{%- if link[0:3] == "ok\t" -%}
{%- set parts = link | split("\t") -%}
{%- set s.out = s.out ~ esc(collapse(parts[2])) -%}
{%- set s.i = parts[1] | int -%}
{%- else -%}
{%- set s.out = s.out ~ "!" -%}
{%- set s.i = s.i + 1 -%}
{%- endif -%}
{%- set s.done = true -%}
{%- endif -%}
{%- if (not s.done) and ch == "[" -%}
{%- set alert = parse_alert(text, s.i) -%}
{%- if (alert | length) > 0 -%}
{%- set aparts = alert | split("\t") -%}
{%- set s.out = s.out ~ esc(capitalize_word(aparts[1]) ~ ":") -%}
{%- set s.i = aparts[0] | int -%}
{%- else -%}
{%- set link = parse_link(text, s.i) -%}
{%- if link[0:3] == "ok\t" -%}
{%- set parts = link | split("\t") -%}
{%- set s.out = s.out ~ '<a href="' ~ esc(parts[3] | trim) ~ '">' ~ esc(collapse(parts[2])) ~ "</a>" -%}
{%- set s.i = parts[1] | int -%}
{%- else -%}
{%- set s.out = s.out ~ esc(ch) -%}
{%- set s.i = s.i + 1 -%}
{%- endif -%}
{%- endif -%}
{%- set s.done = true -%}
{%- endif -%}
{%- if not s.done -%}
{%- set s.out = s.out ~ esc(ch) -%}
{%- set s.i = s.i + 1 -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ s.out }}
{%- endmacro -%}

{#- Trailing newlines removed. -#}
{%- macro trim_end_newlines(text) -%}
{%- set s = namespace(t = text, stop = false) -%}
{%- for _k in range(text | length) -%}
{%- if not s.stop -%}
{%- if (s.t | length) > 0 and s.t[-1:] == "\n" -%}{%- set s.t = s.t[:-1] -%}{%- else -%}{%- set s.stop = true -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ s.t }}
{%- endmacro -%}

{#- "yes" when the line is a GFM table separator row: only space, tab, `:`, `|` and `-`,
    with at least one `-`. -#}
{%- macro is_table_separator(line) -%}
{%- set s = namespace(ok = true, dash = false) -%}
{%- for c in line | list -%}
{%- if c == "-" -%}{%- set s.dash = true -%}
{%- elif c != " " and c != "\t" and c != ":" and c != "|" -%}{%- set s.ok = false -%}
{%- endif -%}
{%- endfor -%}
{%- if s.ok and s.dash -%}yes{%- endif -%}
{%- endmacro -%}

{#- One `^\s*>\s?` marker stripped from the front of a line. -#}
{%- macro strip_quote(line) -%}
{%- set s = namespace(i = 0, stop = false) -%}
{%- for k in range(line | length) -%}
{%- if not s.stop -%}
{%- set c = line[k] -%}
{%- if c == " " or c == "\t" -%}
{%- elif c == ">" -%}
{%- set s.i = k + 1 -%}
{%- if k + 1 < (line | length) and (line[k + 1] == " " or line[k + 1] == "\t") -%}{%- set s.i = k + 2 -%}{%- endif -%}
{%- set s.stop = true -%}
{%- else -%}
{%- set s.stop = true -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ line[s.i:] }}
{%- endmacro -%}

{#- A markdown brief/note as XML-doc content lines, `\n`-joined. Paragraphs are separated by a
    self-closing <para/> line. -#}
{%- macro render_markdown(raw) -%}
{%- set text = trim_end_newlines(raw | default("", true)) -%}
{%- if (text | length) > 0 -%}
{%- set b = namespace(blocks = [], buffer = [], fence = [], in_fence = false) -%}
{%- for line in text.split("\n") -%}
{%- if (line | trim)[0:3] == "```" -%}
{%- if not b.in_fence -%}
{%- if (b.buffer | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": false, "lines": b.buffer}] -%}
{%- set b.buffer = [] -%}
{%- endif -%}
{%- set b.in_fence = true -%}{%- set b.fence = [] -%}
{%- else -%}
{%- set b.blocks = b.blocks + [{"code": true, "lines": b.fence}] -%}
{%- set b.fence = [] -%}{%- set b.in_fence = false -%}
{%- endif -%}
{%- elif b.in_fence -%}
{%- set b.fence = b.fence + [line] -%}
{%- elif ((line | trim) | length) == 0 -%}
{%- if (b.buffer | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": false, "lines": b.buffer}] -%}
{%- set b.buffer = [] -%}
{%- endif -%}
{%- else -%}
{%- set b.buffer = b.buffer + [line] -%}
{%- endif -%}
{%- endfor -%}
{%- if b.in_fence and (b.fence | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": true, "lines": b.fence}] -%}
{%- endif -%}
{%- if (b.buffer | length) > 0 -%}
{%- set b.blocks = b.blocks + [{"code": false, "lines": b.buffer}] -%}
{%- endif -%}
{%- set o = namespace(lines = [], first = true) -%}
{%- for block in b.blocks -%}
{%- set r = namespace(lines = [], skip = false) -%}
{%- if block.code -%}
{%- set r.lines = ["<code>"] -%}
{%- for line in block.lines -%}{%- set r.lines = r.lines + [esc(line)] -%}{%- endfor -%}
{%- set r.lines = r.lines + ["</code>"] -%}
{%- else -%}
{%- set k = namespace(kept = []) -%}
{%- for line in block.lines -%}
{%- if is_table_separator(line) != "yes" -%}{%- set k.kept = k.kept + [line] -%}{%- endif -%}
{%- endfor -%}
{%- if (k.kept | length) == 0 -%}
{%- set r.skip = true -%}
{%- else -%}
{%- set q = namespace(quote = true, any = false) -%}
{%- for line in k.kept -%}
{%- if ((line | trim) | length) > 0 -%}
{%- set q.any = true -%}
{%- if (line | trim)[0:1] != ">" -%}{%- set q.quote = false -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- if q.quote and q.any -%}
{%- set st = namespace(lines = []) -%}
{%- for line in k.kept -%}{%- set st.lines = st.lines + [strip_quote(line)] -%}{%- endfor -%}
{%- set rendered = render_inline(st.lines | join("\n")) | split("\n") | list -%}
{%- if o.first -%}
{%- set r.lines = ["<blockquote>"] + rendered[:-1] + [rendered[-1] ~ "</blockquote>"] -%}
{%- else -%}
{%- set r.lines = rendered -%}
{%- endif -%}
{%- else -%}
{%- set r.lines = render_inline(k.kept | join("\n")) | split("\n") | list -%}
{%- endif -%}
{%- endif -%}
{%- endif -%}
{%- if not r.skip -%}
{%- if not o.first -%}{%- set o.lines = o.lines + ["<para/>"] -%}{%- endif -%}
{%- set o.lines = o.lines + r.lines -%}
{%- set o.first = false -%}
{%- endif -%}
{%- endfor -%}
{{ o.lines | join("\n") }}
{%- endif -%}
{%- endmacro -%}

{#- A `<summary>`/`<remarks>` doc block, `body` already rendered and `\n`-joined. -#}
{%- macro doc_block(pad, tag, body) -%}
{%- set s = namespace(out = pad ~ "/// <" ~ tag ~ ">\n") -%}
{%- if (body | length) > 0 -%}
{%- for line in body.split("\n") -%}
{%- set s.out = s.out ~ pad ~ "///" ~ (" " ~ line if (line | length) > 0 else "") ~ "\n" -%}
{%- endfor -%}
{%- endif -%}
{{ s.out ~ pad ~ "/// </" ~ tag ~ ">" }}
{%- endmacro -%}

{#- The [Obsolete] message: renamed -> "Replaced by X.", obsoleted -> "Removed, no
    replacement.", anything else -> its note, or "Deprecated.". -#}
{%- macro deprecated_message(dep) -%}
{%- if dep.reason == "renamed" -%}
{{ "Replaced by " ~ dep.renamed_to ~ "." }}
{%- elif dep.reason == "obsoleted" -%}
Removed, no replacement.
{%- elif dep.note is defined and dep.note and (dep.note | length) > 0 -%}
{{ dep.note }}
{%- else -%}
Deprecated.
{%- endif -%}
{%- endmacro -%}

{#- Escaped for a C# attribute argument: newlines collapse to a space. -#}
{%- macro escape_attribute(t) -%}
{{ t | replace("\\", "\\\\") | replace('"', '\\"') | replace("\n", " ") | replace("\r", "") }}
{%- endmacro -%}

{#- The `[Obsolete]` line, or nothing. -#}
{%- macro obsolete_line(pad, dep) -%}
{%- if dep -%}
{{ pad ~ '[global::System.Obsolete("' ~ escape_attribute(deprecated_message(dep)) ~ '", false)]' }}
{%- endif -%}
{%- endmacro -%}

{#- A C# string literal. -#}
{%- macro cs_string(v) -%}
{{ '"' ~ (v | replace("\\", "\\\\") | replace('"', '\\"') | replace("\r", "\\r") | replace("\n", "\\n")) ~ '"' }}
{%- endmacro -%}

{#- The value-set members every generated `…Values` class carries after its constants:
    AllValues (every catalogued value, in the order the constants are declared) and Contains
    (ordinal membership). Fully qualified BCL names so the code needs no usings; string
    literals so referencing an [Obsolete] constant never raises CS0618. Numeric enums
    preserve their integer representation throughout constants, collections and setters. -#}
{%- macro value_set(pad, values, summary) -%}
{%- set numeric = (values | length) > 0 and values[0] is number -%}
{%- set cs_type = "long" if numeric else "string" -%}
{{ pad }}/// <summary>{{ summary }}</summary>
{{ pad }}public static global::System.Collections.Generic.IReadOnlyList<{{ cs_type }}> AllValues { get; } = {% if (values | length) == 0 %}global::System.Array.Empty<{{ cs_type }}>(){% else %}new{% if numeric %} long{% endif %}[] { {% for v in values %}{% if not loop.first %}, {% endif %}{% if numeric %}{{ v }}{% else %}{{ cs_string(v) }}{% endif %}{% endfor %} }{% endif %};
{{ pad }}/// <summary>Whether <paramref name="value"/> is a catalogued value{% if not numeric %} (ordinal){% endif %}.</summary>
{{ pad }}public static bool Contains({{ cs_type }} value) { foreach (var candidate in AllValues) if ({% if numeric %}candidate == value{% else %}string.Equals(candidate, value, global::System.StringComparison.Ordinal){% endif %}) return true; return false; }
{%- endmacro -%}

{#- ------------------------------------------------------------------------
    First-class definition expressions (metric, span, event, entity). The
    stability / structured-deprecation / attribute-reference projections are
    identical across all four surfaces.
    ------------------------------------------------------------------------ -#}

{%- macro stability_expr(stability) -%}
global::Qyl.Telemetry.SemanticConventions.Stability.
{%- if stability == "stable" -%}Stable
{%- elif stability == "release_candidate" -%}ReleaseCandidate
{%- elif stability == "beta" -%}Beta
{%- elif stability == "alpha" -%}Alpha
{%- elif stability == "deprecated" -%}Deprecated
{%- else -%}Development
{%- endif -%}
{%- endmacro -%}

{%- macro deprecation_expr(dep) -%}
{%- if not dep -%}
global::Qyl.Telemetry.SemanticConventions.Deprecation.None
{%- elif dep.reason == "renamed" -%}
{{ 'global::Qyl.Telemetry.SemanticConventions.Deprecation.Renamed(' ~ cs_string(dep.renamed_to) ~ ')' }}
{%- elif dep.reason == "obsoleted" -%}
global::Qyl.Telemetry.SemanticConventions.Deprecation.Obsoleted
{%- else -%}
{{ 'global::Qyl.Telemetry.SemanticConventions.Deprecation.Uncategorized(' ~ cs_string(dep.note | default("", true)) ~ ')' }}
{%- endif -%}
{%- endmacro -%}

{#- The requirement level. A level with a condition is a mapping whose one key names the level
    ({conditionally_required: text}, {recommended: text}, {opt_in: text}); the key decides, the
    text is the condition (requirement_level_condition). -#}
{%- macro requirement_level_name(level) -%}
{%- if level == "required" -%}Required
{%- elif level == "recommended" -%}Recommended
{%- elif level == "opt_in" -%}OptIn
{%- elif level == "conditionally_required" -%}ConditionallyRequired
{%- elif level is mapping and level.conditionally_required is defined -%}ConditionallyRequired
{%- elif level is mapping and level.recommended is defined -%}Recommended
{%- elif level is mapping and level.opt_in is defined -%}OptIn
{%- else -%}Unspecified
{%- endif -%}
{%- endmacro -%}

{%- macro requirement_level_expr(level) -%}
global::Qyl.Telemetry.SemanticConventions.RequirementLevel.{{ requirement_level_name(level) }}
{%- endmacro -%}

{#- The condition text of a requirement level, or "" when it states none. -#}
{%- macro requirement_level_condition(level) -%}
{%- if level is mapping -%}
{%- for _k, v in level | items -%}{{ v | trim }}{%- endfor -%}
{%- endif -%}
{%- endmacro -%}

{#- The persistence rule of registry/qyl/policy.yaml, which RegistryPolicy carries at runtime:
    "true" when the qyl collector persists `key`. A not-persisted key also denies its template
    children. Captured fields preserve valid protocol field names after explicit denials. -#}
{%- macro persisted(key, policy) -%}
{%- set s = namespace(denied = false, exempt = false) -%}
{%- for k in policy.not_persisted -%}
{%- if key == k or key[0:(k | length) + 1] == k ~ "." -%}{%- set s.denied = true -%}{%- endif -%}
{%- endfor -%}
{%- for p in policy.not_persisted_prefixes -%}
{%- if key[0:(p | length)] == p -%}{%- set s.denied = true -%}{%- endif -%}
{%- endfor -%}
{%- set lower = key | lower -%}
{%- for root in policy.captured_fields.http_roots + policy.captured_fields.rpc_roots -%}
{%- if lower == root -%}{%- set s.denied = true -%}
{%- elif lower[0:(root | length) + 1] == root ~ "." -%}
{%- set suffix = lower[(root | length) + 1:] -%}
{%- set s.exempt = true -%}
{%- if suffix | length == 0 -%}{%- set s.denied = true -%}{%- endif -%}
{%- set allowed = policy.captured_fields.http_name_characters if root in policy.captured_fields.http_roots else policy.captured_fields.rpc_name_characters -%}
{%- for c in suffix -%}{%- if c not in allowed -%}{%- set s.denied = true -%}{%- endif -%}{%- endfor -%}
{%- endif -%}
{%- endfor -%}
{%- if key in policy.token_exempt or key in policy.vendor_keys -%}{%- set s.exempt = true -%}{%- endif -%}
{%- if not s.denied and not s.exempt -%}
{%- for t in policy.denied_key_tokens -%}
{%- if t in (key | lower) -%}{%- set s.denied = true -%}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{ "false" if s.denied else "true" }}
{%- endmacro -%}

{#- The phase of `key`: End when registry/qyl/policy.yaml annotates it `qyl.phase: end`. -#}
{%- macro phase_expr(key, policy) -%}
global::Qyl.Telemetry.SemanticConventions.AttributePhase.{{ "End" if key in policy.phase_end else "Start" }}
{%- endmacro -%}

{%- macro attribute_type_name(t) -%}
{%- if t is mapping -%}
{%- if t.members is defined -%}enum{%- else -%}string{%- endif -%}
{%- elif t is string and t[0:9] == "template[" -%}template
{%- elif t -%}{{ t }}
{%- else -%}string
{%- endif -%}
{%- endmacro -%}

{%- macro attribute_array_expr(attributes, policy) -%}
{%- if (attributes | length) == 0 -%}
global::System.Array.Empty<global::Qyl.Telemetry.SemanticConventions.AttributeRef>()
{%- else -%}
{%- set s = namespace(out = "new global::Qyl.Telemetry.SemanticConventions.AttributeRef[] { ") -%}
{%- for a in attributes -%}
{%- if not loop.first -%}{%- set s.out = s.out ~ ", " -%}{%- endif -%}
{%- set condition = requirement_level_condition(a.requirement_level) -%}
{%- set s.out = s.out ~ 'new("' ~ escape_attribute(a.key) ~ '", "' ~ attribute_type_name(a.type) ~ '", ' ~ requirement_level_expr(a.requirement_level) ~ ", " ~ ("true" if a.deprecated else "false") ~ ", " ~ (('"' ~ escape_attribute(condition) ~ '"') if (condition | length) > 0 else "null") ~ ", " ~ reference_phase_expr(a, policy) ~ ", " ~ persisted(a.key, policy) ~ ")" -%}
{%- endfor -%}
{{ s.out ~ " }" }}
{%- endif -%}
{%- endmacro -%}

{%- macro value_member_name(type_name, member) -%}
{{ member ~ "Member" if member in ["Key", "Value", "Custom", "Equals", "GetHashCode", "GetType", "ToString"] or member == type_name else member }}
{%- endmacro -%}

{%- macro reference_phase_expr(attribute, policy) -%}
{%- if attribute.annotations is defined and attribute.annotations.qyl is defined and attribute.annotations.qyl.phase is defined -%}
global::Qyl.Telemetry.SemanticConventions.AttributePhase.{{ "End" if attribute.annotations.qyl.phase == "end" else "Start" }}
{%- else -%}
{{ phase_expr(attribute.key, policy) }}
{%- endif -%}
{%- endmacro -%}

{%- macro entity_identity_array_expr(attributes) -%}
{%- if (attributes | length) == 0 -%}
global::System.Array.Empty<global::Qyl.Telemetry.SemanticConventions.EntityIdentityAttributeRef>()
{%- else -%}
new global::Qyl.Telemetry.SemanticConventions.EntityIdentityAttributeRef[] { {% for a in attributes %}{% if not loop.first %}, {% endif %}new("{{ escape_attribute(a.key) }}", "{{ attribute_type_name(a.type) }}", {{ "true" if a.deprecated else "false" }}){% endfor %} }
{%- endif -%}
{%- endmacro -%}

{%- macro entity_array_expr(entities) -%}
{%- if (entities | length) == 0 -%}
global::System.Array.Empty<global::Qyl.Telemetry.SemanticConventions.EntityRef>()
{%- else -%}
{%- set s = namespace(out = "new global::Qyl.Telemetry.SemanticConventions.EntityRef[] { ") -%}
{%- for e in entities -%}
{%- if not loop.first -%}{%- set s.out = s.out ~ ", " -%}{%- endif -%}
{%- set s.out = s.out ~ 'new("' ~ escape_attribute(e.type if e is mapping else e) ~ '")' -%}
{%- endfor -%}
{{ s.out ~ " }" }}
{%- endif -%}
{%- endmacro -%}

{#- The C# parameter type of an attribute, for the Activity setter extensions. -#}
{%- macro parameter_type(t) -%}
{%- if t is mapping -%}{% if t.members is defined and (t.members | length) > 0 and t.members[0].value is number %}long{% else %}string{% endif %}
{%- else -%}
{%- set p = t[9:-1] if (t is string and t[0:9] == "template[") else t -%}
{%- if p == "int" -%}long
{%- elif p == "double" -%}double
{%- elif p == "boolean" -%}bool
{%- elif p == "string[]" -%}string[]
{%- elif p == "int[]" -%}long[]
{%- elif p == "double[]" -%}double[]
{%- elif p == "boolean[]" -%}bool[]
{%- elif p == "any" -%}object
{%- else -%}string
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{#- ------------------------------------------------------------------------
    Span starters and span names.
    ------------------------------------------------------------------------ -#}

{#- The bare camelCase name of `key` as a parameter of a span of type `span_type`: the span's root
    segment is dropped (db.collection.name on db.client -> collectionName), a key of another root
    keeps it (server.port -> serverPort), and the root's system discriminator
    (<root>.system, <root>.system.name) is `system`. -#}
{%- macro param_base(key, span_type) -%}
{%- set root = (span_type | split(".") | list)[0] -%}
{%- set rel = key[(root | length) + 1:] if key[0:(root | length) + 1] == root ~ "." else key -%}
{%- if rel == "system" or rel == "system.name" -%}system
{%- else -%}
{%- set s = namespace(out = "", first = true) -%}
{%- for seg in rel | replace("_", ".") | replace("-", ".") | split(".") -%}
{%- if (seg | length) > 0 -%}
{%- if s.first -%}{%- set s.out = seg -%}{%- set s.first = false -%}
{%- else -%}{%- set s.out = s.out ~ (seg[0] | upper) ~ seg[1:] -%}{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ s.out }}
{%- endif -%}
{%- endmacro -%}

{#- The parameter name as C# writes it: a keyword gets `@`. -#}
{%- macro param_name(key, span_type) -%}
{%- set b = param_base(key, span_type) -%}
{%- set keywords = ["abstract", "as", "base", "bool", "break", "byte", "case", "catch", "char", "checked", "class", "const", "continue", "decimal", "default", "delegate", "do", "double", "else", "enum", "event", "explicit", "extern", "false", "finally", "fixed", "float", "for", "foreach", "goto", "if", "implicit", "in", "int", "interface", "internal", "is", "lock", "long", "namespace", "new", "null", "object", "operator", "out", "override", "params", "private", "protected", "public", "readonly", "ref", "return", "sbyte", "sealed", "short", "sizeof", "stackalloc", "static", "string", "struct", "switch", "this", "throw", "true", "try", "typeof", "uint", "ulong", "unchecked", "unsafe", "ushort", "using", "virtual", "void", "volatile", "while"] -%}
{{ ("@" ~ b) if b in keywords else b }}
{%- endmacro -%}

{#- The value-set struct of an enum attribute, fully qualified: the stable package holds the
    stable and deprecated attributes' structs, the incubating package the rest. -#}
{%- macro struct_type(a) -%}
global::Qyl.Telemetry.SemanticConventions.{{ "" if (a.stability == "stable" or a.deprecated) else "Incubating." }}Activities.{{ pascal(a.key) }}
{%- endmacro -%}

{#- An attribute's starter parameter type: the value-set struct for an enum, else the setter type;
    nullable unless the parameter is required. -#}
{%- macro starter_param_type(a, required) -%}
{%- if a.type is mapping and a.type.members is defined -%}{{ struct_type(a) }}{{ "" if required else "?" }}
{%- else -%}
{%- set t = parameter_type(a.type) -%}
{%- if t == "object" -%}object?
{%- elif required -%}{{ t }}
{%- else -%}{{ t }}?
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{#- The parts of a span-name template, "{a} x {b}": a list of {"key": ...} and {"text": ...}. -#}
{%- macro template_keys(t) -%}
{%- set s = namespace(keys = []) -%}
{%- for piece in (t | split("{") | list)[1:] -%}
{%- set s.keys = s.keys + [(piece | split("}") | list)[0]] -%}
{%- endfor -%}
{{ s.keys | join(",") }}
{%- endmacro -%}

{#- A C# expression concatenating a span-name template: literal text as string literals, each
    {key} as the local `<param>Text`. -#}
{%- macro template_expr(t, span_type) -%}
{%- set pieces = t | split("{") | list -%}
{%- set s = namespace(parts = []) -%}
{%- if (pieces[0] | length) > 0 -%}{%- set s.parts = s.parts + [cs_string(pieces[0])] -%}{%- endif -%}
{%- for piece in pieces[1:] -%}
{%- set kv = piece | split("}") | list -%}
{%- set s.parts = s.parts + [param_base(kv[0], span_type) ~ "Text"] -%}
{%- if (kv[1] | length) > 0 -%}{%- set s.parts = s.parts + [cs_string(kv[1])] -%}{%- endif -%}
{%- endfor -%}
{{ s.parts | join(" + ") }}
{%- endmacro -%}

{#- The keys of the attributes a span starter takes as parameters, comma-joined: every attribute
    of the row except OptIn, `qyl.phase: end`, the group's fixed ones, template and deprecated
    attributes. starters.cs.j2 and the analyzers' typed-surface table both read it. -#}
{%- macro starter_keys(s, rule, policy) -%}
{%- set k = namespace(keys = []) -%}
{%- for a in s.attributes -%}
{%- set level = requirement_level_name(a.requirement_level) -%}
{%- set is_template = (a.type is string) and a.type[0:9] == "template[" -%}
{%- if not (level == "OptIn" or a.key in policy.phase_end or a.key in rule.fixed or is_template or a.deprecated) -%}
{%- set k.keys = k.keys + [a.key] -%}
{%- endif -%}
{%- endfor -%}
{{ k.keys | join(",") }}
{%- endmacro -%}
