{% set req = namespace(v = []) %}
{% for k in exec_one.required_attributes %}
{% if k != exec_one.discriminator_key %}{% set req.v = req.v + [k] %}{% endif %}
{% endfor %}
{% set exec_required = req.v %}
    internal const string ExecuteToolOperationKey = "{{ exec_one.discriminator_key }}";
    internal const string ExecuteToolOperationValue = "execute_tool";
    internal const string ExecuteToolRequiredAttribute = "{{ exec_required[0] }}";

    /// <summary>
    /// The GenAI histograms whose unit is <c>{token}</c>: what QYL0402 names when a token
