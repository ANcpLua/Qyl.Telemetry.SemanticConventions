{% for a in ctx.attributes %}
{% if (a.values | length) > 0 %}
            ["{{ a.key }}"] = new[] { {% for v in a.values %}{% if not loop.first %}, {% endif %}"{{ v }}"{% endfor %} },
{% endif %}
{% endfor %}
        };

    private static readonly HashSet<string> GenAiSpanDiscriminatorKeys =
        new(new[] { {% for k in ctx.genai_discriminators %}{% if not loop.first %}, {% endif %}"{{ k }}"{% endfor %} }, StringComparer.Ordinal);

    private static readonly HashSet<string> KnownScopeNames =
        new(new[] { {% for n in scopes %}{% if not loop.first %}, {% endif %}"{{ n }}"{% endfor %} }, StringComparer.Ordinal);

    private static readonly HashSet<string> KnownEventNames =
