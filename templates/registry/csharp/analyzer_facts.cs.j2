    internal static readonly SemconvSpanRule[] SpanRules =
    {
{% for r in ctx.span_rules %}
        new(
            "{{ r.id }}",
            "{{ r.kind }}",
            "{{ r.discriminator_key }}",
            new[] { {% for v in r.discriminator_values %}{% if not loop.first %}, {% endif %}"{{ v }}"{% endfor %} },
            {{ ('"' ~ r.constraint_key ~ '"') if r.constraint_key else "null" }},
            {{ ('"' ~ r.constraint_value ~ '"') if r.constraint_value else "null" }},
