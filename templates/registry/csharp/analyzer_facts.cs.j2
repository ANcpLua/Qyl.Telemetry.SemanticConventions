    /// </summary>
    internal static readonly string[] GenAiTokenHistogramNames =
    {
{% for n in ctx.genai_token_histograms %}
        "{{ n }}",
{% endfor %}
    };

    private static readonly Dictionary<string, RegistryAttributeValueKind> AttributeKinds =
        new(StringComparer.Ordinal)
        {
{% for a in ctx.attributes %}
{% if not a.template %}
            [{{ lib.cs_string(a.key) }}] = RegistryAttributeValueKind.{{ a.kind }},
{% endif %}
{% endfor %}
        };

    // Wire keys that more than one registry definition uses: a definition whose
    // qyl.openai.literal_name is another definition's key. AttributeKinds keeps the definition
    // that owns the key; these are the other definitions' kinds, valid on the signals that
    // reference them. The type under such a key depends on the signal, which a per-key check
    // cannot see, so it accepts any of them.
    private static readonly Dictionary<string, RegistryAttributeValueKind[]> ContextDependentKinds =
        new(StringComparer.Ordinal)
        {
{% for a in ctx.context_dependent_attributes %}
            [{{ lib.cs_string(a.key) }}] = new[] { {% for kind in a.kinds %}{% if not loop.first %}, {% endif %}RegistryAttributeValueKind.{{ kind }}{% endfor %} },
{% endfor %}
        };

    private static readonly (string Prefix, RegistryAttributeValueKind Kind)[] TemplateKinds =
    {
{% for a in ctx.attributes | sort(attribute="key", reverse=true) %}
{% if a.template %}
        ({{ lib.cs_string(a.key ~ ".") }}, RegistryAttributeValueKind.{{ a.kind }}),
{% endif %}
{% endfor %}
    };

