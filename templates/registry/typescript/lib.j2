{#- Shared macros for the TypeScript templates. -#}

{#- A generation parameter scripts/generate.sh must supply. An unset one writes an explicit error
    marker instead of a stale value, and scripts/check-generated.sh fails on the diff. -#}
{%- macro param(name, value) -%}
{%- if value -%}{{ value }}{%- else -%}{{ "error: missing param " ~ name }}{%- endif -%}
{%- endmacro -%}

{#- The three header lines every module file carries. -#}
{%- macro header(source, registry_snapshot_sha256) -%}
// Generated by scripts/generate.sh from {{ source }}; do not edit.
// Registry snapshot: {{ param("registry_snapshot_sha256", registry_snapshot_sha256) }}
// SPDX-License-Identifier: Apache-2.0
{%- endmacro -%}
