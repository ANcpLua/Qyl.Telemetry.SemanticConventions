{
  "name": "@ancplua/qyl-semantic-conventions",
  "version": "{{ ctx.version }}",
  "description": "qyl semantic convention constants generated from the shared OpenTelemetry registry",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANcpLua/Qyl.Telemetry.SemanticConventions.git",
    "directory": "typescript"
  },
  "exports": {
